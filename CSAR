ain_test_split\nfrom sksurv.metrics import concordance_index_censored\nfrom sksurv.util import Surv\nfrom sksurv.ensemble import (\n    GradientBoostingSurvivalAnalysis)\nimport warnings\nwarnings.filterwarnings('ignore')\n\ntorch.manual_seed(42)\nnp.random.seed(42)\n\nprint(\"=\" * 55)\nprint(\"CELL A6 FIX — CSAR-Net Improved Training\")\nprint(\"=\" * 55)\n\nFEATURES = [\n    'academic_score_mean',\n    'academic_score_early',\n    'academic_trajectory',\n    'engagement_rate',\n    'financial_risk',\n    'prior_attempts',\n    'age_encoded',\n    'gender_encoded',\n    'disability_encoded',\n    'credits_norm',\n    'early_risk'\n]\n\n# ── Data ───────────────────────────────────────────────\ndf_cs = df_combined[\n    FEATURES + ['duration','event']\n].dropna().copy()\ndf_cs = df_cs[df_cs['duration'] > 0]\n\nnp.random.seed(42)\nidx = np.random.choice(\n    len(df_cs), size=20000, replace=False)\ndf_cs = df_cs.iloc[idx].reset_index(drop=True)\n\nX_raw = df_cs[FEATURES].values.astype(float)\nt_raw = df_cs['duration'].values.astype(float)\ne_raw = df_cs['event'].values.astype(float)\n\nscaler = StandardScaler()\nX_sc   = scaler.fit_transform(X_raw)\n\nX_tr, X_te, t_tr, t_te, e_tr, e_te = (\n    train_test_split(\n        X_sc, t_raw, e_raw,\n        test_size=0.2, random_state=42))\nX_tr, X_va, t_tr, t_va, e_tr, e_va = (\n    train_test_split(\n        X_tr, t_tr, e_tr,\n        test_size=0.1, random_state=42))\n\n# ── XGBoost base ───────────────────────────────────────\ny_tr_s = Surv.from_arrays(\n    event=e_tr.astype(bool), time=t_tr)\ny_te_s = Surv.from_arrays(\n    event=e_te.astype(bool), time=t_te)\n\nxgb_base = GradientBoostingSurvivalAnalysis(\n    n_estimators=100, learning_rate=0.05,\n    max_depth=4, min_samples_leaf=12,\n    random_state=42)\nxgb_base.fit(X_tr, y_tr_s)\n\ndef get_xgb_embed(X, X_ref=None):\n    pred = xgb_base.predict(X).reshape(-1,1)\n    if X_ref is not None:\n        m = xgb_base.predict(X_ref).mean()\n        s = xgb_base.predict(X_ref).std()+1e-8\n    else:\n        m, s = pred.mean(), pred.std()+1e-8\n    return (pred - m) / s\n\nxgb_tr = get_xgb_embed(X_tr)\nxgb_va = get_xgb_embed(X_va, X_tr)\nxgb_te = get_xgb_embed(X_te, X_tr)\n\nX_aug_tr = np.hstack([X_tr, xgb_tr])\nX_aug_va = np.hstack([X_va, xgb_va])\nX_aug_te = np.hstack([X_te, xgb_te])\nin_dim   = X_aug_tr.shape[1]\n\n# ── Improved CSAR-Net ──────────────────────────────────\nclass CausalAttention(nn.Module):\n    def __init__(self, dim):\n        super().__init__()\n        self.attn = nn.Sequential(\n            nn.Linear(dim, dim),\n            nn.Tanh(),\n            nn.Linear(dim, dim),\n            nn.Softmax(dim=1)\n        )\n    def forward(self, x):\n        w = self.attn(x)\n        return x * w, w\n\nclass ResidualBlock(nn.Module):\n    def __init__(self, dim):\n        super().__init__()\n        self.block = nn.Sequential(\n            nn.Linear(dim, dim*2),\n            nn.BatchNorm1d(dim*2),\n            nn.ReLU(),\n            nn.Dropout(0.15),\n            nn.Linear(dim*2, dim),\n            nn.BatchNorm1d(dim),\n            nn.ReLU()\n        )\n        self.skip = nn.Linear(dim, dim)\n    def forward(self, x):\n        return self.block(x) + self.skip(x)\n\nclass CSARNet(nn.Module):\n    def __init__(self, in_dim, hidden=128):\n        super().__init__()\n        self.embed = nn.Sequential(\n            nn.Linear(in_dim, hidden),\n            nn.BatchNorm1d(hidden),\n            nn.ReLU(),\n            nn.Dropout(0.15)\n        )\n        # Two residual blocks\n        self.res1 = ResidualBlock(hidden)\n        self.res2 = ResidualBlock(hidden)\n        self.causal = CausalAttention(hidden)\n        self.cox = nn.Sequential(\n            nn.Linear(hidden, hidden//2),\n            nn.ReLU(),\n            nn.Dropout(0.1),\n            nn.Linear(hidden//2, 1)\n        )\n    def forward(self, x):\n        h = self.embed(x)\n        h = self.res1(h)\n        h = self.res2(h)\n        h, w = self.causal(h)\n        return self.cox(h), w\n\ndef cox_loss(log_h, t, e):\n    order  = torch.argsort(t, descending=True)\n    log_h  = log_h[order]\n    e      = e[order]\n    lcs    = torch.logcumsumexp(log_h, dim=0)\n    return -torch.mean((log_h - lcs) * e)\n\ndevice = torch.device(\n    'cuda' if torch.cuda.is_available() else 'cpu')\nprint(f\"  Device     : {device}\")\nprint(f\"  Hidden dim : 128 (was 64)\")\nprint(f\"  Residual   : 2 blocks (was 1)\")\nprint(f\"  LR decay   : StepLR(50, 0.5) (was 20)\")\n\nmodel = CSARNet(in_dim=in_dim,\n                hidden=128).to(device)\nopt   = torch.optim.Adam(\n    model.parameters(),\n    lr=5e-4, weight_decay=1e-4)\nsch   = torch.optim.lr_scheduler.StepLR(\n    opt, step_size=50, gamma=0.5)\n\ndef T(a):\n    return torch.FloatTensor(a).to(device)\n\nXtr=T(X_aug_tr); ttr=T(t_tr); etr=T(e_tr)\nXva=T(X_aug_va); tva=T(t_va); eva=T(e_va)\nXte=T(X_aug_te)\n\n# ── Training loop ──────────────────────────────────────\nbest_loss = np.inf\nbest_wts  = None\npatience  = 20\np_ctr     = 0\n\nprint(f\"\\n  Training 200 epochs...\")\nfor epoch in range(200):\n    model.train()\n    opt.zero_grad()\n    lh, _ = model(Xtr)\n    loss   = cox_loss(lh.squeeze(), ttr, etr)\n    loss.backward()\n    torch.nn.utils.clip_grad_norm_(\n        model.parameters(), 1.0)\n    opt.step()\n    sch.step()\n\n    model.eval()\n    with torch.no_grad():\n        lh_va, _ = model(Xva)\n        vl = cox_loss(\n            lh_va.squeeze(), tva, eva)\n\n    if vl.item() < best_loss:\n        best_loss = vl.item()\n        best_wts  = {\n            k: v.clone()\n            for k, v in model.state_dict().items()\n        }\n        p_ctr = 0\n    else:\n        p_ctr += 1\n\n    if p_ctr >= patience:\n        print(f\"  Early stop @ epoch {epoch+1}\")\n        break\n\n    if (epoch+1) % 40 == 0:\n        print(f\"  Epoch {epoch+1:>3} | \"\n              f\"train={loss.item():.4f} | \"\n              f\"val={vl.item():.4f}\")\n\nmodel.load_state_dict(best_wts)\n\n# ── Evaluate ───────────────────────────────────────────\nmodel.eval()\nwith torch.no_grad():\n    lh_te, attn_te = model(Xte)\nrisk = lh_te.squeeze().cpu().numpy()\n\nc_csar2 = concordance_index_censored(\n    e_te.astype(bool), t_te, risk)[0]\n\nprint(f\"\\n  CSAR-Net v2 C-index : {c_csar2:.4f}\")\n\n# ── Gradient attribution ───────────────────────────────\nXte_g = torch.FloatTensor(\n    X_aug_te).to(device).requires_grad_(True)\nlh_g, _ = model(Xte_g)\nlh_g.sum().backward()\nimp = (Xte_g.grad.abs()\n       .mean(dim=0).cpu().numpy())\nfeat_names = FEATURES + ['xgb_embedding']\nimp_df = pd.Series(\n    imp, index=feat_names\n).sort_values(ascending=False)\n\nprint(\"\\n── Feature Attribution ──\")\nfor f, v in imp_df.items():\n    bar = '█' * int(v*200)\n    print(f\"  {f:<28} {v:.4f} {bar}\")\n\n# ── Final scoreboard ───────────────────────────────────\nprint(\"\\n\" + \"=\"*55)\nprint(\"FINAL SCOREBOARD\")\nprint(\"=\"*55)\nscores = {\n    'XGBoost-Cox' : 0.8924,\n    'Cox PH'      : 0.8871,\n    'DeepHit'     : 0.8816,\n    'CSAR-Net v1' : 0.8799,\n    'RSF'         : 0.8764,\n    'CSAR-Net v2' : c_csar2,\n}\nranked = sorted(\n    scores.items(),\n    key=lambda x: x[1], reverse=True)\nfor name, sc in ranked:\n    mk = ' ← BEST' if name==ranked[0][0] else ''\n    print(f\"  {name:<25} {sc:.4f}{mk}\")\n\nprint(\"\\n✅ Cell A6 fix done. Paste output.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-23T09:47:04.611575Z","iopub.execute_input":"2026-07-23T09:47:04.612597Z"}},"outputs":[{"name":"stdout","text":"=======================================================\nCELL A6 FIX — CSAR-Net Improved Training\n=======================================================\n","output_type":"stream"}],"execution_count":null},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}