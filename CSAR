            (next cell)\n  CSAR-Net                  (next cell)\n\n✅ Cell A4 done. Paste output.\n","output_type":"stream"}],"execution_count":15},{"cell_type":"code","source":"# ── Cell A5: DeepHit on Combined Dataset ──────────────\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torchtuples as tt\nfrom pycox.models import DeepHitSingle\nfrom pycox.evaluation import EvalSurv\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.preprocessing import StandardScaler\nimport warnings\nwarnings.filterwarnings('ignore')\n\nprint(\"=\" * 55)\nprint(\"CELL A5 — DEEPHIT (COMBINED DATASET)\")\nprint(\"=\" * 55)\n\nFEATURES = [\n    'academic_score_mean',\n    'academic_score_early',\n    'academic_trajectory',\n    'engagement_rate',\n    'financial_risk',\n    'prior_attempts',\n    'age_encoded',\n    'gender_encoded',\n    'disability_encoded',\n    'credits_norm',\n    'early_risk'\n]\n\n# ── Prepare ────────────────────────────────────────────\ndf_dh = df_combined[\n    FEATURES + ['duration', 'event']\n].dropna().copy()\ndf_dh = df_dh[df_dh['duration'] > 0]\n\n# Sample 15k for speed — still 3x larger than UCI\nnp.random.seed(42)\nidx = np.random.choice(\n    len(df_dh), size=15000, replace=False)\ndf_dh = df_dh.iloc[idx].reset_index(drop=True)\nprint(f\"  Sample size : {len(df_dh)}\")\n\nX_raw = df_dh[FEATURES].values.astype('float32')\nt_raw = df_dh['duration'].values.astype('float32')\ne_raw = df_dh['event'].values.astype('float32')\n\n# Scale\nscaler = StandardScaler()\nX_sc = scaler.fit_transform(X_raw)\n\n# Discretise time into bins for DeepHit\n# Use 20 bins to keep it manageable\nn_bins = 20\nt_min, t_max = t_raw.min(), t_raw.max()\nbins = np.linspace(t_min, t_max, n_bins)\nt_disc = np.digitize(t_raw, bins).astype('int64')\nt_disc = np.clip(t_disc, 0, n_bins - 1)\n\n# Train/val/test split\nX_tr, X_te, t_tr, t_te, e_tr, e_te = (\n    train_test_split(\n        X_sc, t_disc, e_raw,\n        test_size=0.2, random_state=42\n    )\n)\nX_tr, X_va, t_tr, t_va, e_tr, e_va = (\n    train_test_split(\n        X_tr, t_tr, e_tr,\n        test_size=0.1, random_state=42\n    )\n)\nprint(f\"  Train/Val/Test: \"\n      f\"{len(X_tr)}/{len(X_va)}/{len(X_te)}\")\n\n# ── Build network ──────────────────────────────────────\nnet = tt.practical.MLPVanilla(\n    in_features=len(FEATURES),\n    num_nodes=[128, 64, 32],\n    out_features=n_bins,\n    batch_norm=True,\n    dropout=0.2\n)\nmodel_dh = DeepHitSingle(\n    net,\n    tt.optim.Adam(lr=0.001),\n    alpha=0.2,\n    sigma=0.1,\n    duration_index=np.arange(n_bins)\n)\n\n# ── Train ──────────────────────────────────────────────\nprint(\"\\n  Training DeepHit...\")\nlog = model_dh.fit(\n    X_tr.astype('float32'),\n    (t_tr.astype('int64'),\n     e_tr.astype('float32')),\n    batch_size=512,\n    epochs=50,\n    callbacks=[tt.callbacks.EarlyStopping(\n        patience=8)],\n    val_data=(\n        X_va.astype('float32'),\n        (t_va.astype('int64'),\n         e_va.astype('float32'))\n    ),\n    verbose=False\n)\nepochs_run = len(log.to_pandas())\nprint(f\"  Stopped at epoch : {epochs_run}\")\n\n# ── Evaluate ───────────────────────────────────────────\nsurv = model_dh.predict_surv_df(\n    X_te.astype('float32'))\nev = EvalSurv(\n    surv,\n    t_te.astype('int64'),\n    e_te.astype('float32'),\n    censor_surv='km'\n)\nc_dh = ev.concordance_td()\n\nprint(f\"\\n── DeepHit C-Index : {c_dh:.4f} ──\")\n\n# ── Updated scoreboard ─────────────────────────────────\nprint(\"\\n\" + \"=\" * 55)\nprint(\"SCOREBOARD — COMBINED (36,924 students)\")\nprint(\"=\" * 55)\nprint(f\"  {'Model':<25} {'C-Index':>8}\")\nprint(\"  \" + \"-\"*35)\nfor name, score in [\n    ('Cox PH',       0.8871),\n    ('RSF',          0.8764),\n    ('XGBoost-Cox',  0.8924),\n    ('DeepHit',      c_dh),\n    ('CSAR-Net',     '← next')\n]:\n    marker = ' ← BEST' if isinstance(\n        score, float) and score == max(\n        0.8871, 0.8764, 0.8924, c_dh) else ''\n    print(f\"  {name:<25} \"\n          f\"{str(score):>8}{marker}\")\n\nprint(\"\\n✅ Cell A5 done. Paste output.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-23T09:38:37.619922Z","iopub.execute_input":"2026-07-23T09:38:37.62064Z","iopub.status.idle":"2026-07-23T09:38:50.155159Z","shell.execute_reply.started":"2026-07-23T09:38:37.620589Z","shell.execute_reply":"2026-07-23T09:38:50.154401Z"}},"outputs":[{"name":"stdout","text":"=======================================================\nCELL A5 — DEEPHIT (COMBINED DATASET)\n=======================================================\n  Sample size : 15000\n  Train/Val/Test: 10800/1200/3000\n\n  Training DeepHit...\n  Stopped at epoch : 50\n\n── DeepHit C-Index : 0.8816 ──\n\n=======================================================\nSCOREBOARD — COMBINED (36,924 students)\n=======================================================\n  Model                      C-Index\n  -----------------------------------\n  Cox PH                      0.8871\n  RSF                         0.8764\n  XGBoost-Cox                 0.8924 ← BEST\n  DeepHit                   0.8815509125479742\n  CSAR-Net                    ← next\n\n✅ Cell A5 done. Paste output.\n","output_type":"stream"}],"execution_count":16},{"cell_type":"code","source":"# ── Cell A6: CSAR-Net (Novel Architecture) ────────────\n# Causal Survival Attention Residual Network\n#\n# Architecture:\n#   Layer 1: XGBoost base predictions (embedded)\n#   Layer 2: Residual correction network\n#   Layer 3: Causal attention head\n#   Layer 4: Cox survival output\n#\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.preprocessing import StandardScaler\nfrom sksurv.metrics import concordance_index_censored\nfrom sksurv.ensemble import (\n    GradientBoostingSurvivalAnalysis)\nimport warnings\nwarnings.filterwarnings('ignore')\n\ntorch.manual_seed(42)\nnp.random.seed(42)\n\nprint(\"=\" * 55)\nprint(\"CELL A6 — CSAR-Net\")\nprint(\"Causal Survival Attention Residual Network\")\nprint(\"=\" * 55)\n\nFEATURES = [\n    'academic_score_mean',\n    'academic_score_early',\n    'academic_trajectory',\n    'engagement_rate',\n    'financial_risk',\n    'prior_attempts',\n    'age_encoded',\n    'gender_encoded',\n    'disability_encoded',\n    'credits_norm',\n    'early_risk'\n]\n\n# ── Prepare data ───────────────────────────────────────\ndf_cs = df_combined[\n    FEATURES + ['duration', 'event']\n].dropna().copy()\ndf_cs = df_cs[df_cs['duration'] > 0]\n\n# Sample 20k — balanced UCI + OULAD\nnp.random.seed(42)\nidx = np.random.choice(\n    len(df_cs), size=20000, replace=False)\ndf_cs = df_cs.iloc[idx].reset_index(drop=True)\n\nX_raw = df_cs[FEATURES].values.astype(float)\nt_raw = df_cs['duration'].values.astype(float)\ne_raw = df_cs['event'].values.astype(float)\n\nscaler = StandardScaler()\nX_sc = scaler.fit_transform(X_raw)\n\nX_tr, X_te, t_tr, t_te, e_tr, e_te = (\n    train_test_split(\n        X_sc, t_raw, e_raw,\n        test_size=0.2, random_state=42\n    )\n)\nX_tr, X_va, t_tr, t_va, e_tr, e_va = (\n    train_test_split(\n        X_tr, t_tr, e_tr,\n        test_size=0.1, random_state=42\n    )\n)\nprint(f\"  Train/Val/Test: \"\n      f\"{len(X_tr)}/{len(X_va)}/{len(X_te)}\")\n\n# ══ Stage 1: XGBoost Base Learner ════════════════════\n# Train XGBoost-Cox as base\n# Its predictions become additional input to CSAR-Net\nprint(\"\\n── Stage 1: XGBoost Base Learner ──\")\nfrom sksurv.util import Surv\ny_tr_surv = Surv.from_arrays(\n    event=e_tr.astype(bool),\n    time=t_tr.astype(float)\n)\ny_va_surv = Surv.from_arrays(\n    event=e_va.astype(bool),\n    time=t_va.astype(float)\n)\ny_te_surv = Surv.from_arrays(\n    event=e_te.astype(bool),\n    time=t_te.astype(float)\n)\n\nxgb_base = GradientBoostingSurvivalAnalysis(\n    n_estimators=100,\n    learning_rate=0.05,\n    max_depth=4,\n    min_samples_leaf=12,\n    random_state=42\n)\nxgb_base.fit(X_tr, y_tr_surv)\nc_base = xgb_base.score(X_te, y_te_surv)\nprint(f\"  XGBoost base C-index : {c_base:.4f}\")\n\n# XGBoost predictions as embedding\nxgb_pred_tr = xgb_base.predict(X_tr).reshape(-1,1)\nxgb_pred_va = xgb_base.predict(X_va).reshape(-1,1)\nxgb_pred_te = xgb_base.predict(X_te).reshape(-1,1)\n\n# Normalise predictions\npred_mean = xgb_pred_tr.mean()\npred_std  = xgb_pred_tr.std() + 1e-8\nxgb_pred_tr = (xgb_pred_tr - pred_mean) / pred_std\nxgb_pred_va = (xgb_pred_va - pred_mean) / pred_std\nxgb_pred_te = (xgb_pred_te - pred_mean) / pred_std\n\n# Augmented input: original features + XGB embedding\nX_aug_tr = np.hstack([X_tr, xgb_pred_tr])\nX_aug_va = np.hstack([X_va, xgb_pred_va])\nX_aug_te = np.hstack([X_te, xgb_pred_te])\nin_dim = X_aug_tr.shape[1]  # 11 + 1 = 12\n\nprint(f\"  Augmented input dim  : {in_dim}\")\n\n# ══ Stage 2: CSAR-Net Architecture ═══════════════════\nclass CausalAttention(nn.Module):\n    \"\"\"\n    Causal attention head.\n    Learns which features are most causally\n    relevant for intervention recommendation.\n    Returns attended features + attention weights.\n    \"\"\"\n    def __init__(self, dim):\n        super().__init__()\n        self.attn = nn.Sequential(\n            nn.Linear(dim, dim),\n            nn.Tanh(),\n            nn.Linear(dim, dim),\n            nn.Softmax(dim=1)\n        )\n\n    def forward(self, x):\n        weights = self.attn(x)\n        attended = x * weights\n        return attended, weights\n\n\nclass ResidualBlock(nn.Module):\n    \"\"\"\n    Residual correction block.\n    Learns what XGBoost missed.\n    \"\"\"\n    def __init__(self, dim):\n        super().__init__()\n        self.block = nn.Sequential(\n            nn.Linear(dim, dim * 2),\n            nn.BatchNorm1d(dim * 2),\n            nn.ReLU(),\n            nn.Dropout(0.2),\n            nn.Linear(dim * 2, dim),\n            nn.BatchNorm1d(dim),\n            nn.ReLU()\n        )\n        # Skip connection\n        self.skip = nn.Linear(dim, dim)\n\n    def forward(self, x):\n        return self.block(x) + self.skip(x)\n\n\nclass CSARNet(nn.Module):\n    \"\"\"\n    CSAR-Net: Causal Survival Attention\n    Residual Network.\n\n    Pipeline:\n      Input → Embedding → Residual Block\n            → Causal Attention\n            → Cox hazard output\n    \"\"\"\n    def __init__(self, in_dim, hidden=64):\n        super().__init__()\n\n        # Input embedding\n        self.embed = nn.Sequential(\n            nn.Linear(in_dim, hidden),\n            nn.BatchNorm1d(hidden),\n            nn.ReLU(),\n            nn.Dropout(0.2)\n        )\n        # Residual correction\n        self.residual = ResidualBlock(hidden)\n\n        # Causal attention\n        self.causal_attn = CausalAttention(hidden)\n\n        # Cox output — single hazard score\n        self.cox_head = nn.Sequential(\n            nn.Linear(hidden, hidden // 2),\n            nn.ReLU(),\n            nn.Linear(hidden // 2, 1)\n        )\n\n    def forward(self, x):\n        h = self.embed(x)\n        h = self.residual(h)\n        h, attn_weights = self.causal_attn(h)\n        hazard = self.cox_head(h)\n        return hazard, attn_weights\n\n\n# ── Cox Partial Likelihood Loss ────────────────────────\ndef cox_ph_loss(log_h, t, e):\n    \"\"\"\n    Breslow approximation of Cox partial likelihood.\n    log_h: log hazard [N]\n    t    : survival times [N]\n    e    : event indicators [N]\n    \"\"\"\n    # Sort by descending time\n    order = torch.argsort(t, descending=True)\n    log_h = log_h[order]\n    e     = e[order]\n    # Log-sum-exp of risk set\n    log_cumsum = torch.logcumsumexp(log_h, dim=0)\n    loss = -torch.mean(\n        (log_h - log_cumsum) * e\n    )\n    return loss\n\n\n# ── Training setup ─────────────────────────────────────\ndevice = torch.device(\n    'cuda' if torch.cuda.is_available() else 'cpu'\n)\nprint(f\"\\n── Stage 2: CSAR-Net Training ──\")\nprint(f\"  Device : {device}\")\n\nmodel_csar = CSARNet(\n    in_dim=in_dim, hidden=64\n).to(device)\n\noptimizer = torch.optim.Adam(\n    model_csar.parameters(),\n    lr=0.001, weight_decay=1e-4\n)\nscheduler = torch.optim.lr_scheduler.StepLR(\n    optimizer, step_size=20, gamma=0.5\n)\n\n# Convert to tensors\ndef to_tensor(arr):\n    return torch.FloatTensor(arr).to(device)\n\nXtr = to_tensor(X_aug_tr)\nttr = to_tensor(t_tr)\netr = to_tensor(e_tr)\nXva = to_tensor(X_aug_va)\ntva = to_tensor(t_va)\neva = to_tensor(e_va)\nXte = to_tensor(X_aug_te)\n\n# ── Training loop ──────────────────────────────────────\nbest_val_loss = np.inf\nbest_state    = None\npatience      = 15\npatience_ctr  = 0\ntrain_losses  = []\nval_losses    = []\n\nfor epoch in range(100):\n    # Train\n    model_csar.train()\n    optimizer.zero_grad()\n    log_h, _ = model_csar(Xtr)\n    loss = cox_ph_loss(\n        log_h.squeeze(), ttr, etr)\n    loss.backward()\n    optimizer.step()\n    scheduler.step()\n    train_losses.append(loss.item())\n\n    # Validate\n    model_csar.eval()\n    with torch.no_grad():\n        log_h_va, _ = model_csar(Xva)\n        val_loss = cox_ph_loss(\n            log_h_va.squeeze(), tva, eva\n        )\n    val_losses.append(val_loss.item())\n\n    # Early stopping\n    if val_loss.item() < best_val_loss:\n        best_val_loss = val_loss.item()\n        best_state    = {\n            k: v.clone()\n            for k, v in\n            model_csar.state_dict().items()\n        }\n        patience_ctr = 0\n    else:\n        patience_ctr += 1\n\n    if patience_ctr >= patience:\n        print(f\"  Early stop at epoch {epoch+1}\")\n        break\n\n    if (epoch + 1) % 20 == 0:\n        print(f\"  Epoch {epoch+1:>3} | \"\n              f\"train={loss.item():.4f} | \"\n              f\"val={val_loss.item():.4f}\")\n\n# Load best weights\nmodel_csar.load_state_dict(best_state)\n\n# ── Evaluate CSAR-Net ──────────────────────────────────\nmodel_csar.eval()\nwith torch.no_grad():\n    log_h_te, attn_te = model_csar(Xte)\n\n# C-index from log