lib.patches as mpatches\n\n# ── Prepare base dataset ───────────────────────────────\nfeatures_uplift = [f for f in features\n                   if f != 'cumulative_risk_score']\n\ndf_up = df[features_uplift +\n           ['duration', 'event',\n            'Target', 'risk_group']].dropna().copy()\n\nX_base = df_up[features_uplift].values\nfeat_idx = {f: i for i, f in\n            enumerate(features_uplift)}\n\n# ── Predict baseline hazard (risk score) ──────────────\n# Higher prediction = higher dropout hazard\nbaseline_risk = xgb_cox2.predict(X_base)\n\n# ── Intervention T1: Financial Aid ────────────────────\n# Simulate: tuition paid, no debt\nX_t1 = X_base.copy()\nX_t1[:, feat_idx['Tuition fees up to date']] = 1\nX_t1[:, feat_idx['Debtor']]                  = 0\n# Recalculate financial_risk_index\nX_t1[:, feat_idx['financial_risk_index']]    = 0\n# Recalculate financial_academic_interaction\ncsr2_col = feat_idx['credit_success_ratio_sem2']\nX_t1[:, feat_idx[\n    'financial_academic_interaction']] = (\n    0 * (1 - X_t1[:, csr2_col])\n)\nrisk_t1 = xgb_cox2.predict(X_t1)\nuplift_t1 = baseline_risk - risk_t1  # positive = helped\n\n# ── Intervention T2: Academic Support ─────────────────\n# Simulate: CSR boosted by +0.2 (capped at 1.0)\nX_t2 = X_base.copy()\nX_t2[:, feat_idx[\n    'credit_success_ratio_sem1']] = np.clip(\n    X_base[:, feat_idx[\n        'credit_success_ratio_sem1']] + 0.2, 0, 1)\nX_t2[:, feat_idx[\n    'credit_success_ratio_sem2']] = np.clip(\n    X_base[:, feat_idx[\n        'credit_success_ratio_sem2']] + 0.2, 0, 1)\n# Update trajectory and velocity\nX_t2[:, feat_idx['csr_trajectory']] = (\n    X_t2[:, feat_idx['credit_success_ratio_sem2']] -\n    X_t2[:, feat_idx['credit_success_ratio_sem1']]\n)\nrisk_t2 = xgb_cox2.predict(X_t2)\nuplift_t2 = baseline_risk - risk_t2\n\n# ── Intervention T3: Scholarship ──────────────────────\n# Simulate: scholarship assigned\nX_t3 = X_base.copy()\nX_t3[:, feat_idx['Scholarship holder']] = 1\nrisk_t3 = xgb_cox2.predict(X_t3)\nuplift_t3 = baseline_risk - risk_t3\n\n# ── Assign best intervention per student ──────────────\ndf_up['baseline_risk'] = baseline_risk\ndf_up['uplift_t1_financial']  = uplift_t1\ndf_up['uplift_t2_academic']   = uplift_t2\ndf_up['uplift_t3_scholarship'] = uplift_t3\n\ndf_up['best_intervention'] = pd.Series(\n    np.select(\n        [\n            (uplift_t2 >= uplift_t1) &\n            (uplift_t2 >= uplift_t3),\n            (uplift_t1 >= uplift_t2) &\n            (uplift_t1 >= uplift_t3),\n        ],\n        ['Academic Support', 'Financial Aid'],\n        default='Scholarship'\n    )\n)\n\n# ── Summary ────────────────────────────────────────────\nprint(\"=\" * 55)\nprint(\"CAUSAL UPLIFT — INTERVENTION ANALYSIS\")\nprint(\"=\" * 55)\n\nprint(\"\\n── Mean Uplift per Intervention ──\")\nprint(f\"  Financial Aid    : \"\n      f\"{uplift_t1.mean():.4f} \"\n      f\"(std={uplift_t1.std():.4f})\")\nprint(f\"  Academic Support : \"\n      f\"{uplift_t2.mean():.4f} \"\n      f\"(std={uplift_t2.std():.4f})\")\nprint(f\"  Scholarship      : \"\n      f\"{uplift_t3.mean():.4f} \"\n      f\"(std={uplift_t3.std():.4f})\")\n\nprint(\"\\n── Best Intervention Distribution ──\")\nbc = df_up['best_intervention'].value_counts()\nfor k, v in bc.items():\n    print(f\"  {k:<20} → {v:>4} students \"\n          f\"({v/len(df_up)*100:.1f}%)\")\n\nprint(\"\\n── Uplift by Risk Group ──\")\nprint(f\"  {'Group':<15} {'Baseline':>9} \"\n      f\"{'T1-Fin':>9} {'T2-Acad':>9} \"\n      f\"{'T3-Schol':>9}\")\nprint(\"  \" + \"-\"*55)\nfor grp in ['Low Risk', 'Medium Risk', 'High Risk']:\n    sub = df_up[df_up['risk_group'] == grp]\n    print(f\"  {grp:<15} \"\n          f\"{sub['baseline_risk'].mean():>9.4f} \"\n          f\"{sub['uplift_t1_financial'].mean():>9.4f} \"\n          f\"{sub['uplift_t2_academic'].mean():>9.4f} \"\n          f\"{sub['uplift_t3_scholarship'].mean():>9.4f}\")\n\n# ── Figure ─────────────────────────────────────────────\nfig, axes = plt.subplots(1, 3, figs